<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      AppCompat-based so the Cast framework's MediaRouteButton + its chooser/controller
      dialogs can resolve their theme attributes (they crash on a plain framework theme).
      The app itself is Compose — this only supplies attrs and the cold-start window.
    -->
    <style name="Theme.Dexxicon" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/dexxicon_window_bg</item>
        <item name="android:colorBackground">@color/dexxicon_window_bg</item>
        <item name="colorPrimary">@color/dexxicon_primary</item>
        <item name="colorPrimaryDark">@color/dexxicon_window_bg</item>
        <item name="colorAccent">@color/dexxicon_primary</item>
        <!--
          issue #306 — Android 15+ still draws this colour (translucent) behind 3-button
          navigation, so it must stay transparent; the system then adds its own light or dark
          contrast scrim to match the bar appearance DexxiconTheme sets. The status bar colour
          and cutout mode are no longer set: Android 15+ ignores both for an edge-to-edge app.
        -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
