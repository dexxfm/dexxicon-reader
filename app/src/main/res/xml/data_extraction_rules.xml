<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup / transfer rules. Everything the user configures (theme, book
    layout, storage limit, reader + player display prefs) lives in DataStore, and the
    library (servers, reading position, downloads, bookmarks, highlights) lives in the
    Room database — all of it round-trips so a restore never lands the app on defaults.

    Excluded: the encrypted credential store and session cookies. Their keys are
    non-exportable AndroidKeyStore keys, so the ciphertext is useless on another device
    anyway, and it should not sit in a cloud backup. A restored install simply re-prompts
    for each server's password.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/dexxicon_credentials.preferences_pb" />
        <exclude domain="sharedpref" path="dexxicon_cookies_v1.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/dexxicon_credentials.preferences_pb" />
        <exclude domain="sharedpref" path="dexxicon_cookies_v1.xml" />
    </device-transfer>
</data-extraction-rules>
