<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for Android 11 and below. Same intent as data_extraction_rules.xml:
    back up settings (DataStore) and the library (Room), keep the encrypted credential
    store and session cookies off the backup.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/dexxicon_credentials.preferences_pb" />
    <exclude domain="sharedpref" path="dexxicon_cookies_v1.xml" />
</full-backup-content>
