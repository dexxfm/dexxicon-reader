<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Concept B: single-ribbon monoline fox with a bookmark tail. -->

    <!-- bookmark ribbon falling from the chin -->
    <path
        android:fillColor="#8A94A6"
        android:pathData="M48,74 h12 v24 l-6,-7 -6,7 Z" />

    <!-- muzzle / lower-face fill — Phase 4 (issue #115): the app's accent color, previously the
         old Blue400 (#3D5A8A), now Aqua (the mockup's confirmed pick). This is drawn on the fixed
         navy launcher background regardless of in-app theme, so it uses the dark-ground Aqua
         step (AquaAccentDark in theme/Color.kt), same reasoning as DarkColors using it against
         Navy900. issue #324: drawn under the head outline so the thinner outline keeps an even
         width. -->
    <path
        android:fillColor="#57C9B4"
        android:pathData="M33,61 C 35,71 43,79 54,79 C 65,79 73,71 75,61
                          C 67,67 61,70 54,70 C 47,70 41,67 33,61 Z" />

    <!-- fox head: one continuous ribbon stroke (issue #324: thinner, softer grey) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#C7CED9"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M54,80
                          C 42,80 34,71 32,60
                          L28,32 L44,44
                          C 50,41 58,41 64,44
                          L80,32 L76,60
                          C 74,71 66,80 54,80 Z" />

    <!-- eyes + nose: a mid grey, smaller, eyes closer together (issue #324) -->
    <path
        android:fillColor="#9AA4B4"
        android:pathData="M46.85,55 m-2.35,0 a2.35,2.35 0 1,0 4.7,0 a2.35,2.35 0 1,0 -4.7,0" />
    <path
        android:fillColor="#9AA4B4"
        android:pathData="M61.15,55 m-2.35,0 a2.35,2.35 0 1,0 4.7,0 a2.35,2.35 0 1,0 -4.7,0" />
    <path
        android:fillColor="#9AA4B4"
        android:pathData="M51.3,61.15 h5.4 l-2.7,2.75 Z" />
</vector>
