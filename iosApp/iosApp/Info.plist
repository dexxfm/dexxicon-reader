<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Dexxicon Reader</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.15.0</string>
	<key>CFBundleVersion</key>
	<string>37</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Export compliance: the app only ever uses HTTPS/TLS to talk to a user-configured
	     server, the OS Keychain for credential storage, and hashing (SHA-256 for OIDC PKCE,
	     MD5 for KOReader sync digests — not encryption) — no custom/non-exempt encryption.
	     Declaring this up front skips the manual "Missing Compliance" prompt App Store
	     Connect otherwise asks on every single upload before a build can reach testers. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- issue #169: Compose Multiplatform's own startup sanity check (PlistSanityCheck)
	     throws an uncaught fatal exception on launch without this — required for smooth
	     scrolling on ProMotion/high-refresh-rate displays, not optional polish. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- issue #114: without this, AVAudioSession playback is silently cut short the moment
	     the app backgrounds — required for the audiobook player's whole reason for having
	     MPNowPlayingInfoCenter/lock-screen controls at all, not optional polish. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
