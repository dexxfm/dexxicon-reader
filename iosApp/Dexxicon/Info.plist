<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Dexxicon Reader</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.2.2</string>
	<key>CFBundleVersion</key>
	<string>44</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- issue #267: self-hosted servers are often plain HTTP on the local network. ATS already
	     exempts raw IP addresses (http://192.168.1.200:3001); this also allows plain HTTP to
	     local hostnames (.local names and single-label names like http://nas:3001). HTTP to a
	     fully-qualified public hostname stays blocked, as ATS intends. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Export compliance: the app only ever uses HTTPS/TLS to talk to a user-configured
	     server, the OS Keychain for credential storage, and hashing (SHA-256 for OIDC PKCE,
	     MD5 for KOReader sync digests — not encryption) — no custom/non-exempt encryption.
	     Declaring this up front skips the manual "Missing Compliance" prompt App Store
	     Connect otherwise asks on every single upload before a build can reach testers. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- issue #169: Compose Multiplatform's own startup sanity check (PlistSanityCheck)
	     throws an uncaught fatal exception on launch without this — required for smooth
	     scrolling on ProMotion/high-refresh-rate displays, not optional polish. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- issue #114: without this, AVAudioSession playback is silently cut short the moment
	     the app backgrounds — required for the audiobook player's whole reason for having
	     MPNowPlayingInfoCenter/lock-screen controls at all, not optional polish. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- issue #119: CarPlay connects as a second, concurrent scene alongside the phone/iPad
	     UIWindowScene. A previous version of this comment claimed the dynamic
	     AppDelegate.application(_:configurationForConnecting:options:) routing alone was
	     enough — that was wrong, confirmed by a real crash: "Application does not implement
	     CarPlay template application lifecycle methods in its scene delegate"
	     (NSGenericException). Unlike a plain UIWindowScene, CPTemplateApplicationScene needs a
	     *static* UISceneConfigurations entry for its role — the system checks this before ever
	     calling the dynamic delegate method. The dynamic AppDelegate routing stays too (it's
	     what actually wires up CarPlaySceneDelegate as the class instance), this static entry
	     just satisfies the system's own upfront validation. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>CPTemplateApplicationScene</string>
					<key>UISceneConfigurationName</key>
					<string>CarPlay</string>
					<key>UISceneDelegateClassName</key>
					<string>CarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
